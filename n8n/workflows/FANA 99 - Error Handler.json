{
  "name": "FANA 99 - Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "0fd31618-bfd6-443b-8f71-18d0205f4829",
      "name": "On Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst err = ex.error || {};\nconst msg = String(err.message || err.description || 'unknown error').slice(0, 500);\nconst node = ex.lastNodeExecuted || (err.node && err.node.name) || 'unknown node';\n// No customer payload is copied here: only workflow, node, error text and execution link (data minimisation)\nreturn [{ json: {\n  level: 'error',\n  stage: (wf.name || 'unknown workflow') + ' > ' + node,\n  lead_key: '',\n  message: msg + (ex.id ? ' | execution ' + ex.id : ''),\n  at: new Date().toISOString(),\n  alert_text: '⚠️ FANA system error\\nWorkflow: ' + (wf.name || '-') + '\\nNode: ' + node + '\\nError: ' + msg +\n    '\\nMode: ' + (ex.mode || '-') + (ex.url ? '\\nExecution: ' + ex.url : '') +\n    '\\nAction: event was NOT marked processed - safe to replay after the fix.'\n} }];"
      },
      "id": "6db0f6e9-a30f-4e55-b865-dcf2126aa293",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
