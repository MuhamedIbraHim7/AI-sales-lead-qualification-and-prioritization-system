    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $json.lead;\nconst groups = [];\nif (lead.mobile) {\n  // Exact E.164 match for contacts created by this system\n  groups.push({ filters: [{ propertyName: 'phone', operator: 'EQ', value: lead.mobile }] });\n  // HubSpot's calculated national number matches contacts typed by hand in any format\n  // (0533334444, +966-53-333-4444, 966533334444 ...). Saudi mobiles: last 9 digits.\n  if (lead.mobile.startsWith('+966')) {\n    groups.push({ filters: [{ propertyName: 'hs_searchable_calculated_phone_number', operator: 'EQ', value: lead.mobile.slice(4) }] });\n  }\n}\nif (lead.email) groups.push({ filters: [{ propertyName: 'email', operator: 'EQ', value: lead.email }] });\ngroups.push({ filters: [{ propertyName: 'fana_lead_key', operator: 'EQ', value: lead.lead_key }] });\nreturn { json: { search_body: { filterGroups: groups.slice(0, 5), limit: 1,\n  properties: ['firstname', 'lastname', 'phone', 'email', 'fana_lead_key'] } } };"
      },
      "id": "406e9c4d-9b64-43ac-9c8d-4f8cc535fcaa",
      "name": "Build Search Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        224
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotOAuth2Api",
        "sendBody": true,
