    {
      "parameters": {
        "jsCode": "const d = $('Deal Result').first().json;\nconst lead = JSON.parse(d.lead_json);\nlet prev = {};\ntry { const row = $('Load Existing Lead').first().json; if (row && row.lead_json) prev = JSON.parse(row.lead_json); } catch (e) { prev = {}; }\n// Escalation types, most urgent first. Alert only when the type CHANGES (no spam on every message).\nconst kind = l => {\n  const fl = l.flags || {};\n  if (!l.priority || l.priority === 'Disqualified') return null;\n  if (fl.human_requested) return 'human';\n  if (l.priority === 'P1') return 'p1';\n  if (l.qualification_status === 'needs_review') return 'review';\n  return null;\n};\nconst now = kind(lead), before = kind(prev);\nconst LABEL = { human: '🙋 طلب التحدث مع موظف - اتصل الآن', p1: '🔥 عميل جاهز للمبيعات (P1)', review: '🔍 يحتاج مراجعة بشرية (إجابة غير واضحة)' };\nconst alert = Boolean(now) && now !== before;\nconst text = alert ? [\n  'FANA | ' + LABEL[now],\n  'الاسم: ' + (lead.name || '-'),\n  'الجوال: ' + (lead.mobile || '-'),\n  lead.reason_ar,\n  d.hubspot_deal_id && d.hubspot_deal_id !== 'null' ? 'HubSpot: https://app-eu1.hubspot.com/contacts/149403776/record/0-3/' + d.hubspot_deal_id : ''\n].filter(Boolean).join('\\n') : '';\nreturn [{ json: { alert, kind: now, previous_kind: before, text } }];"
      },
