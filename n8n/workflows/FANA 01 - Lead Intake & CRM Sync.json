    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $('Build Deal Payload').first().json;\nconst found = ($json.results || [])[0] || null;\n// HubSpot search is eventually consistent (new records appear after a few seconds).\n// The deal id saved on the lead is the primary key; search is the fallback for leads not yet linked.\nlet stored = null;\ntry {\n  const saved = JSON.parse($('Collect Result').first().json.lead_json).hubspot_deal_id;\n  if (saved && saved !== 'null' && saved !== 'undefined') stored = String(saved);\n} catch (e) { stored = null; }\nconst SALES_OWNED = ['6144414950', '6144414951', 'closedwon'];\nconst props = { ...b.deal_properties };\n// Never move a deal backwards once sales has advanced it (Contacted / Registered / Won)\nif (found && SALES_OWNED.includes((found.properties || {}).dealstage)) delete props.dealstage;\nconst dealId = (found && found.id) || stored || null;\nconst source = found ? 'search' : (stored ? 'stored_id' : 'new');\nreturn { json: { deal_id: dealId, deal_id_source: source, properties: props, contact_id: b.contact_id } };"
