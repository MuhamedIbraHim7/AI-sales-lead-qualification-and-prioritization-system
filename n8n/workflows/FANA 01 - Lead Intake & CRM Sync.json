      "parameters": {
        "jsCode": "const c = $('Collect Result').first().json;\nconst f = $('Finalize Deal Payload').first().json;\nconst handoffReady = $('Build Deal Payload').first().json.handoff_ready;\nlet dealId = f.deal_id;\nif (!dealId) { try { dealId = $('Create HubSpot Deal').first().json.id; } catch (e) { dealId = null; } }\nconst lead = JSON.parse(c.lead_json);\nlead.hubspot_deal_id = String(dealId);\nlead.sales_handoff_ready = handoffReady;\nreturn { json: { ...c, lead_json: JSON.stringify(lead), hubspot_deal_id: String(dealId),\n  response: { ...c.response, hubspot_deal_id: String(dealId), deal_action: f.deal_id ? 'update' : 'create',\n    deal_id_source: f.deal_id_source,\n    deal_stage: f.properties.dealstage || 'unchanged (sales-owned stage)', sales_handoff_ready: handoffReady } } };"
