        }
      },
      "id": "472650e7-99c5-4a57-a0b0-1d9c873ce06e",
      "name": "Search HubSpot Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2224,
        224
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "hubspotOAuth2Api": {
          "id": "qpa56nfhAFdiCBoL",
          "name": "HubSpot account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $('Qualify Lead (Agent)').first().json;\nconst lead = m.lead;\nconst found = ($json.results || [])[0] || null;\nconst parts = (lead.name || '').split(' ').filter(Boolean);\nconst props = {\n  firstname: parts[0], lastname: parts.slice(1).join(' ') || undefined,\n  phone: lead.mobile, email: lead.email, city: lead.city,\n  fana_lead_key: lead.lead_key, fana_lead_source: lead.first_source,\n  preferred_contact_method: lead.preferred_contact !== 'unknown' ? lead.preferred_contact : undefined,\n  contact_consent: lead.consent !== 'unknown' ? lead.consent : undefined,\n};\n// Send only known values so CRM data is never overwritten with blanks\nfor (const k of Object.keys(props)) if (props[k] === null || props[k] === undefined || props[k] === '') delete props[k];\nconst contactId = (found && found.id) || lead.hubspot_contact_id || null;\nreturn { json: { contact_id: contactId, contact_action: contactId ? 'update' : 'create',\n  existing_crm_contact: Boolean(found) && m.is_new, properties: props } };"
      },
      "id": "80e70ced-4ba1-455a-a728-221b745e8e64",
      "name": "Build Contact Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
