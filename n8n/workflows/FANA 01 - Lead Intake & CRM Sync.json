    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json;\nconst lead = JSON.parse(c.lead_json);\nconst STAGE = { newLead: '6144414946', aiQualifying: '6144414947', followUp: '6144414948', salesReady: '6144414949' };\nlet stage;\nif (lead.priority === 'Disqualified') stage = 'closedlost';\nelse if (lead.priority === 'P1') stage = STAGE.salesReady;\nelse if (lead.priority === 'P2') stage = STAGE.followUp;\nelse stage = (lead.sources || []).includes('whatsapp') ? STAGE.aiQualifying : STAGE.newLead;\nconst asset = lead.interested_asset || (lead.property_type ? 'type_' + lead.property_type : 'unknown');\nconst mid = lead.budget_min && lead.budget_max ? (lead.budget_min + lead.budget_max) / 2 : (lead.budget_max || lead.budget_min || null);\nconst parts = (lead.reason_en || '').split(' | ');\n// Disqualified reasons do not contain the asset segment, so fall back to the asset id/type\nconst assetLabel = lead.priority === 'Disqualified'\n  ? (asset === 'unknown' ? 'asset unknown' : asset)\n  : (parts[(lead.flags || {}).human_requested ? 2 : 1] || 'asset unknown');\nconst f = lead.flags || {};\n// Sales can take over: ready now (P1), asked for a person, or all core facts collected\nconst handoffReady = lead.priority !== 'Disqualified' && (lead.priority === 'P1' || Boolean(f.human_requested) || lead.qualification_status === 'qualified');\nconst budgetChanges = (lead.history || []).filter(h => h.field === 'budget_max' || h.field === 'budget_min');\nconst summary = [\n  'Channels: ' + (lead.sources || []).join(', '),\n  'Qualification: ' + lead.qualification_status + (lead.missing_fields && lead.missing_fields.length ? ' (missing: ' + lead.missing_fields.join(', ') + ')' : ''),\n  'Sales handoff ready: ' + (handoffReady ? 'YES' : 'no'),\n  f.human_requested ? 'Customer asked to speak to a person.' : '',\n  f.price_only ? 'Customer asked about prices only.' : '',\n  f.contact_later ? 'Customer asked to be contacted later.' : '',\n  budgetChanges.length ? 'Budget revised: ' + budgetChanges.map(h => h.field + ' ' + h.old + ' -> ' + h.new).join('; ') : '',\n  lead.existing_crm_contact ? 'Matched an existing HubSpot contact.' : '',\n  lead.message_text ? 'Last customer message: ' + String(lead.message_text).slice(0, 240) : ''\n].filter(Boolean).join('\\n');\nconst props = {\n  dealname: 'التلال الشرقية - ' + (lead.name || lead.mobile || 'Lead') + ' - ' + assetLabel,\n  pipeline: 'default', dealstage: stage, fana_lead_key: lead.lead_key, interested_asset: asset,\n  budget_min: lead.budget_min, budget_max: lead.budget_max, amount: mid,\n  qualification_score: lead.score, qualification_status: lead.qualification_status, sales_priority: lead.priority,\n  purchase_timeline: lead.timeline, financial_readiness: lead.financing, lead_channel: lead.first_source,\n  sales_handoff_ready: handoffReady ? 'true' : 'false',\n  priority_reason: lead.reason_ar + '\\n' + lead.reason_en, ai_summary: summary\n};\nfor (const k of Object.keys(props)) if (props[k] === null || props[k] === undefined || props[k] === '') delete props[k];\nreturn { json: { deal_properties: props, contact_id: c.hubspot_contact_id, handoff_ready: handoffReady,\n  search_body: { filterGroups: [{ filters: [{ propertyName: 'fana_lead_key', operator: 'EQ', value: lead.lead_key }] }], properties: ['dealstage', 'dealname'], limit: 1 } } };"
      },
